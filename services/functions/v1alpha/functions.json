{
  "components": {
    "parameters": {
      "force": {
        "description": "If true, deletes all child resources. If false, the resource remains in a 'deletion state' while child resources exist.",
        "in": "query",
        "name": "force",
        "schema": {
          "default": false,
          "type": "boolean"
        }
      },
      "functionId": {
        "description": "The STACKIT Functions functionId",
        "in": "path",
        "name": "functionId",
        "required": true,
        "schema": {
          "format": "uuid",
          "type": "string"
        }
      },
      "maxLines": {
        "description": "Maximum line output count",
        "in": "query",
        "name": "maxLines",
        "schema": {
          "default": 100,
          "format": "int32",
          "maximum": 10000,
          "minimum": 1,
          "type": "integer"
        }
      },
      "page": {
        "description": "A page to retrieve the next page of results.",
        "in": "query",
        "name": "page",
        "schema": {
          "maxLength": 1024,
          "type": "string"
        }
      },
      "projectId": {
        "description": "The STACKIT portal project UUID the resource is located in.",
        "in": "path",
        "name": "projectId",
        "required": true,
        "schema": {
          "format": "uuid",
          "type": "string"
        }
      },
      "pullCredentialId": {
        "description": "The identifier of the OCI registry pull credential configuration",
        "in": "path",
        "name": "pullCredentialId",
        "required": true,
        "schema": {
          "format": "uuid",
          "type": "string"
        }
      },
      "revisionId": {
        "description": "The identifier of the revision",
        "in": "path",
        "name": "revisionId",
        "required": true,
        "schema": {
          "format": "uuid",
          "type": "string"
        }
      }
    },
    "responses": {
      "badRequest": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Bad Request. The data provided by the client did not match expectations."
      },
      "conflict": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Conflict. The resource has been modified by some other client. Please try again."
      },
      "error": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "The returned error response object"
      },
      "internalServerError": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Internal server error. The function experienced some unexpected situation."
      },
      "methodNotAllowed": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "The method is not allowed for the requested resource."
      },
      "notFound": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Not found. The resource has not been found."
      },
      "unauthorized": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "message": {
                  "example": "Unauthorized",
                  "type": "string"
                }
              },
              "type": "object"
            }
          }
        },
        "description": "Unauthorized. You may have provided no or wrong credentials."
      }
    },
    "schemas": {
      "CreateFunctionPayload": {
        "description": "Represents a STACKIT Functions function.",
        "properties": {
          "created_at": {
            "description": "Time the function was created.",
            "format": "date-time",
            "type": "string"
          },
          "current_revision": {
            "description": "The ID of the currently-deployed revision associated with this function.",
            "type": "string"
          },
          "id": {
            "description": "Unique identifier for the function.",
            "type": "string"
          },
          "labels": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "name": {
            "description": "User-defined name of the function.",
            "type": "string"
          },
          "state": {
            "description": "Status of this function's latest revision.",
            "enum": [
              "CREATING",
              "ACTIVE",
              "FAILED"
            ],
            "type": "string"
          },
          "state_error": {
            "description": "Error message related to this function's status.",
            "type": "string"
          },
          "updated_at": {
            "description": "Time the function was last updated.",
            "format": "date-time",
            "type": "string"
          },
          "url": {
            "description": "URLs that resolve to the function.",
            "items": {
              "type": "string"
            },
            "maxItems": 100,
            "type": "array"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "CreatePullCredentialPayload": {
        "properties": {
          "address": {
