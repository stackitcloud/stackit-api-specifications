          },
          "password": {
            "description": "The password for the OCI registry pull-credentials.",
            "type": "string"
          },
          "username": {
            "description": "The username for the OCI registry pull-credentials.",
            "type": "string"
          }
        },
        "required": [
          "address",
          "username",
          "password"
        ],
        "type": "object"
      },
      "Error": {
