{
  "components": {
    "schemas": {
      "CreateGroupPayload": {
        "properties": {
          "description": {
            "description": "A description of the group's purpose.",
            "example": "This group contains all developers",
            "maxLength": 1024,
            "type": "string"
          },
          "displayName": {
            "description": "The display name of the group. Must start and end with a lowercase letter, German umlaut (ä, ü, ö, ß), or number, and can only contain lowercase letters, umlauts, numbers, hyphens, and underscores.",
            "example": "developers-group",
            "maxLength": 255,
            "type": "string"
          }
        },
        "required": [
          "displayName"
        ],
        "type": "object"
      },
      "CreateGroupResponse": {
        "description": "Response object for group creation.",
        "properties": {
          "createdAt": {
            "example": "2023-01-01T12:00:00Z",
            "type": "string"
          },
          "description": {
            "example": "This is a sample group",
            "type": "string"
          },
          "displayName": {
            "example": "Developers Group",
            "type": "string"
          },
          "id": {
            "example": "123e4567-e89b-12d3-a456-426614174000",
            "type": "string"
          },
          "origin": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Origin"
              }
            ],
            "example": "STACKIT",
            "type": "object"
          }
        },
        "type": "object"
      },
      "GetGroupResponse": {
        "properties": {
          "createdAt": {
            "example": "2023-01-01T12:00:00Z",
            "type": "string"
          },
          "description": {
            "example": "This is a sample group",
            "type": "string"
          },
          "displayName": {
            "example": "Developers Group",
            "type": "string"
          },
          "id": {
            "example": "123e4567-e89b-12d3-a456-426614174000",
            "type": "string"
          },
          "isTopLevel": {
            "example": false,
            "type": "boolean"
          },
          "origin": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Origin"
              }
            ],
            "example": "STACKIT",
            "type": "object"
          }
        },
        "type": "object"
      },
      "GetUserResponse": {
        "properties": {
          "createdAt": {
            "example": "2019-08-24T14:15:22Z",
            "type": "string"
          },
          "displayName": {
            "example": "John Doe",
            "type": "string"
          },
          "email": {
            "example": "john.doe@example.com",
            "type": "string"
          },
          "id": {
            "example": "123e4567-e89b-12d3-a456-426614174000",
            "type": "string"
          },
          "origin": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Origin"
              }
            ],
            "example": "STACKIT",
            "type": "object"
          }
        },
        "type": "object"
      },
      "ListGroupResponse": {
        "properties": {
          "groups": {
            "items": {
              "$ref": "#/components/schemas/GetGroupResponse"
            },
            "type": "array"
          },
          "total": {
            "example": 1,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "ListUserResponse": {
        "properties": {
          "total": {
            "example": 1,
            "type": "integer"
          },
          "users": {
            "items": {
              "$ref": "#/components/schemas/GetUserResponse"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "MemberResponse": {
        "properties": {
          "id": {
            "example": "user-12345",
            "type": "string"
          },
          "type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/MemberType"
              }
            ],
            "example": "user",
            "type": "object"
          }
        },
        "type": "object"
      },
      "MemberType": {
        "enum": [
          "user",
          "group",
          "service_account"
        ],
        "type": "string"
      },
      "MembersResponse": {
        "description": "Response object for group updates.",
        "properties": {
          "id": {
            "example": "123e4567-e89b-12d3-a456-426614174000",
            "type": "string"
          },
          "members": {
            "items": {
              "$ref": "#/components/schemas/MemberResponse"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "Origin": {
        "description": "The system of origin for the resource.",
        "enum": [
          "STACKIT",
          "SCIM"
        ],
        "type": "string"
      },
      "StandardError": {
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "timeStamp": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "UpdateGroupMembersPayload": {
        "properties": {
          "members": {
            "items": {
              "$ref": "#/components/schemas/UpdateMemberRequest"
            },
            "type": "array"
          }
        },
        "required": [
          "members"
        ],
        "type": "object"
      },
      "UpdateGroupPayload": {
        "properties": {
          "description": {
            "example": "Updated group description",
            "maxLength": 1024,
            "type": "string"
          },
          "displayName": {
            "example": "Updated Developers Group",
            "maxLength": 255,
            "type": "string"
          }
        },
        "required": [
          "description",
          "displayName"
        ],
        "type": "object"
      },
      "UpdateGroupResponse": {
        "description": "Response object for group updates.",
        "properties": {
          "createdAt": {
            "example": "2023-01-01T12:00:00Z",
            "type": "string"
          },
          "description": {
            "example": "Updated group description",
            "type": "string"
          },
          "displayName": {
            "example": "Updated Developers Group",
            "type": "string"
          },
          "id": {
            "example": "123e4567-e89b-12d3-a456-426614174000",
            "type": "string"
          },
          "updatedAt": {
            "example": "2023-01-02T15:30:00Z",
            "type": "string"
          }
        },
        "type": "object"
      },
      "UpdateMemberRequest": {
        "properties": {
          "id": {
            "example": "user-12345",
            "type": "string"
          },
          "type": {
            "enum": [
              "user",
              "group",
              "service_account"
            ],
            "example": "user",
            "type": "string"
          }
        },
        "required": [
          "id",
          "type"
        ],
        "type": "object"
      }
    }
  },
