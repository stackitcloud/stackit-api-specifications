    "/v1/organizations/{organizationId}/groups/{groupId}": {
      "delete": {
        "description": "Deletes a specific group. If removeAssignments=true, it automatically detaches all associated members and roles. If removeAssignments=false, the request fails with a 409 Conflict if any assignments exist.",
        "operationId": "DeleteGroup",
        "parameters": [
          {
            "description": "Organization ID (UUID)",
            "in": "path",
            "name": "organizationId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Group ID (UUID)",
            "in": "path",
            "name": "groupId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Automatically detach all relations before deleting",
            "in": "query",
            "name": "removeAssignments",
            "schema": {
              "default": false,
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/StandardError"
                }
              }
            },
            "description": "Invalid UUID format or missing parameters"
          },
          "401": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/StandardError"
                }
              }
            },
            "description": "Unauthorized"
